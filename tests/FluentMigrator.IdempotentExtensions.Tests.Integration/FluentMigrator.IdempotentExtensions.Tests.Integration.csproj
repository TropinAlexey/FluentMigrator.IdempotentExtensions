  <ItemGroup>
    <ProjectReference Include="..\..\src\FluentMigrator.IdempotentExtensions\FluentMigrator.IdempotentExtensions.csproj" />
    <ProjectReference Include="..\..\src\FluentMigrator.IdempotentExtensions.SqlServer\FluentMigrator.IdempotentExtensions.SqlServer.csproj" />
